# Copy to backend/.env and fill in. Unlike the frontend's, these are real
# secrets — .env is gitignored and must stay that way.

# ── Runtime ──────────────────────────────────────────────────────────────────
# "development" is an explicit opt-in that relaxes five protections: HTTPS is
# not enforced, any localhost origin passes CORS, unapproved and rejected
# businesses are served publicly, error responses carry stack traces, and
# request logging is verbose. Anything else — including leaving it unset —
# gets production behaviour. Set it to "production" on the host anyway, so the
# intent is recorded rather than inferred; /health reports what the process sees.
NODE_ENV=development
PORT=5000
# Number of proxies between this process and the client. Leave unset (defaults
# to 1, correct for Render's single load balancer). Set to 2 only if you later
# put Cloudflare or another proxy IN FRONT of Render. Never "true".
# TRUST_PROXY_HOPS=1

# How many cluster workers `npm start` forks. os.cpus().length is unreliable in
# a container — it often reports the HOST's core count, not this instance's CPU
# share — so on a constrained plan set this explicitly, or you fork more workers
# than there is CPU to run them (each also opens its own MongoDB pool:
# MONGO_MAX_POOL_SIZE x workers connections).
#   Render Free (fraction of a core): 1
#   Render Starter (~0.5 CPU):         1  (try 2 only if you measure a benefit)
#   Render Standard (1 CPU):           2
#   Dedicated-CPU plans:               up to the vCPU count
# Unset -> falls back to os.cpus().length, then to 1.
# WEB_CONCURRENCY=1

# ── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=

# ── Auth secrets (one per audience — do not reuse a value across them) ───────
JWT_SECRET=
ADMIN_JWT_SECRET=
TOURIST_JWT_SECRET=

# ── First admin owner ────────────────────────────────────────────────────────
# Seeds the first owner only while the AdminUser collection is empty.
# ADMIN_PASSWORD_HASH is a bcrypt hash (starts with $2), never the plaintext.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# ── Integrations (optional — /health reports which are configured) ───────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GROQ_API_KEY=
# Override when Groq retires the default hosted model.
GROQ_MODEL=
GOOGLE_CLIENT_ID=
