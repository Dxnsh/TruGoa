# Copy to backend/.env and fill in. Unlike the frontend's, these are real
# secrets — .env is gitignored and must stay that way.

# ── Runtime ──────────────────────────────────────────────────────────────────
# "development" is an explicit opt-in that relaxes five protections: HTTPS is
# not enforced, any localhost origin passes CORS, unapproved and rejected
# businesses are served publicly, error responses carry stack traces, and
# request logging is verbose. Anything else — including leaving it unset —
# gets production behaviour. Set it to "production" on the host anyway, so the
# intent is recorded rather than inferred; /health reports what the process sees.
NODE_ENV=development
PORT=5000

# ── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=

# ── Auth secrets (one per audience — do not reuse a value across them) ───────
JWT_SECRET=
ADMIN_JWT_SECRET=
TOURIST_JWT_SECRET=

# ── First admin owner ────────────────────────────────────────────────────────
# Seeds the first owner only while the AdminUser collection is empty.
# ADMIN_PASSWORD_HASH is a bcrypt hash (starts with $2), never the plaintext.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# ── Integrations (optional — /health reports which are configured) ───────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GROQ_API_KEY=
# Override when Groq retires the default hosted model.
GROQ_MODEL=
GOOGLE_CLIENT_ID=
