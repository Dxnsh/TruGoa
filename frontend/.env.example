# Copy to frontend/.env and fill in. Every VITE_* variable is baked into the
# bundle at build time, so treat all of them as public — never put a secret here.

# Base URL of the TruGoa API, including the /api/v1 suffix and no trailing slash.
# Required: there is no fallback, and the production build fails without it.
#   local:      http://localhost:5000/api/v1
#   production: https://trugoa.onrender.com/api/v1
# Must also be set in the Vercel project environment for Production AND Preview.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Google OAuth client id for tourist sign-in. The client's authorised JavaScript
# origins must list every origin the app is served from, localhost:5173 included.
VITE_GOOGLE_CLIENT_ID=
